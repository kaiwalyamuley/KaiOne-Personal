rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User root document and all subcollections with real-time multi-device sync
    match /users/{userId} {
      allow read, write: if request.auth != null;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}

