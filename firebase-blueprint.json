{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "monthlySavingsTarget": { "type": "number" },
        "emergencyFundTarget": { "type": "number" },
        "targetDailyWaterMl": { "type": "number" },
        "targetDailySleepHours": { "type": "number" }
      },
      "required": ["name", "currencySymbol"]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "dateTime": { "type": "string" }
      },
      "required": ["amount", "type", "category", "dateTime"]
    },
    "Account": {
      "title": "Account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "initialBalance": { "type": "number" }
      },
      "required": ["name", "type"]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "CreditCard": {
      "title": "CreditCard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cardName": { "type": "string" },
        "creditLimit": { "type": "number" }
      },
      "required": ["cardName"]
    },
    "Loan": {
      "title": "Loan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loanName": { "type": "string" },
        "principalAmount": { "type": "number" }
      },
      "required": ["loanName"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" }
      },
      "required": ["title", "targetAmount"]
    },
    "Habit": {
      "title": "Habit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["title"]
    },
    "HabitCompletion": {
      "title": "HabitCompletion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "habitId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["habitId", "date"]
    },
    "Workout": {
      "title": "Workout",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["type", "date"]
    },
    "Vitals": {
      "title": "Vitals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["date"]
    },
    "Vacation": {
      "title": "Vacation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "destination": { "type": "string" }
      },
      "required": ["destination"]
    },
    "DateToRemember": {
      "title": "DateToRemember",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["title", "date"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "month": { "type": "string" },
        "allocatedAmount": { "type": "number" }
      },
      "required": ["categoryId", "month", "allocatedAmount"]
    },
    "GoalBadge": {
      "title": "GoalBadge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isUnlocked": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "HabitBadge": {
      "title": "HabitBadge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isUnlocked": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "WealthParams": {
      "title": "WealthParams",
      "type": "object",
      "properties": {
        "currentAge": { "type": "number" },
        "targetRetirementAge": { "type": "number" },
        "expectedReturnPercent": { "type": "number" },
        "inflationPercent": { "type": "number" }
      },
      "required": ["currentAge", "targetRetirementAge"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transactions"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "User bank/cash accounts"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "User categories"
    },
    "/users/{userId}/creditCards/{cardId}": {
      "schema": "CreditCard",
      "description": "User credit cards"
    },
    "/users/{userId}/loans/{loanId}": {
      "schema": "Loan",
      "description": "User loans"
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": "SavingsGoal",
      "description": "User savings goals"
    },
    "/users/{userId}/monthlyBudgets/{budgetId}": {
      "schema": "MonthlyBudget",
      "description": "User monthly category budgets and rollovers"
    },
    "/users/{userId}/goalBadges/{badgeId}": {
      "schema": "GoalBadge",
      "description": "User savings goal milestone badges"
    },
    "/users/{userId}/wealthParams/{docId}": {
      "schema": "WealthParams",
      "description": "User wealth forecasting parameters"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": "Habit",
      "description": "User habits"
    },
    "/users/{userId}/habitCompletions/{recordId}": {
      "schema": "HabitCompletion",
      "description": "User habit completion records"
    },
    "/users/{userId}/habitBadges/{badgeId}": {
      "schema": "HabitBadge",
      "description": "User atomic habit badges"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "User workout sessions"
    },
    "/users/{userId}/vitals/{vitalId}": {
      "schema": "Vitals",
      "description": "User health vitals"
    },
    "/users/{userId}/vacations/{vacationId}": {
      "schema": "Vacation",
      "description": "User vacation plans"
    },
    "/users/{userId}/datesToRemember/{dateId}": {
      "schema": "DateToRemember",
      "description": "User important dates"
    }
  }
}
